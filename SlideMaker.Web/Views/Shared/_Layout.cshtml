<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dev AI Slide Maker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark app-topnav px-3">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-light d-md-none" id="sidebarToggle"><i class="bi bi-list"></i></button>
            <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-easel3 me-1"></i>Dev AI Slide Maker
            </a>
        </div>
        <form class="d-none d-md-flex flex-grow-1 mx-4" style="max-width:480px;" asp-area="SlideMaker" asp-controller="Search" asp-action="Index" method="get">
            <div class="input-group">
                <input type="search" id="globalSearchInput" name="q" class="form-control" placeholder="Search anything..." autocomplete="off" />
                <button class="btn btn-outline-light mic-btn" type="button" data-mic-for="globalSearchInput" title="Speak"><i class="bi bi-mic"></i></button>
                <button class="btn btn-light" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>
        <div class="text-light small">Default User</div>
    </nav>

    @{
        var currentArea = ViewContext.RouteData.Values["area"] as string ?? "";
        var currentController = ViewContext.RouteData.Values["controller"] as string ?? "";
        var currentAction = ViewContext.RouteData.Values["action"] as string ?? "";
        var currentMode = Context.Request.Query["mode"].ToString();
        var isBankCreate = currentController == "Presentation" && currentAction == "Create" && currentMode == "bank";

        var isDashboard = string.IsNullOrEmpty(currentArea) && currentController == "Home";
        var isCreatePresentation = currentController == "Presentation" && !isBankCreate;
        var isTemplates = currentController == "Template";
        var isQuestionBank = currentController == "Question" || isBankCreate;
        var isSearch = currentController == "Search";
    }
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <nav class="nav flex-column py-3">
                <a class="nav-link @(isDashboard ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2 me-2"></i>Dashboard</a>
                <a class="nav-link @(isCreatePresentation ? "active" : "")" asp-area="SlideMaker" asp-controller="Presentation" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Create Presentation</a>
                <a class="nav-link @(isTemplates ? "active" : "")" asp-area="SlideMaker" asp-controller="Template" asp-action="Index"><i class="bi bi-layout-text-window me-2"></i>My Templates</a>
                <a class="nav-link @(isQuestionBank ? "active" : "")" asp-area="SlideMaker" asp-controller="Presentation" asp-action="Create" asp-route-mode="bank"><i class="bi bi-collection me-2"></i>Question Bank</a>
                <a class="nav-link @(isSearch ? "active" : "")" asp-area="SlideMaker" asp-controller="Search" asp-action="Index"><i class="bi bi-search me-2"></i>Search</a>
            </nav>
        </aside>

        <main class="app-content">
            <div id="globalLoader"><div class="loader-ring"></div></div>
            <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>

            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/voice-input.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
