@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Dashboard</h3>
    <a class="btn btn-primary" asp-area="SlideMaker" asp-controller="Presentation" asp-action="Create">
        <i class="bi bi-plus-circle me-1"></i>Create Presentation
    </a>
</div>

<div class="card dashboard-card mb-4">
    <div class="card-body quick-ai-box">
        <h5 class="mb-1"><i class="bi bi-stars me-1 text-primary"></i>What do you want to create?</h5>
        <p class="text-muted small mb-3">e.g. "Class 10 Science Chapter 3 ke 20 MCQ banao, har question ke baad answer aur explanation ki slide ho."</p>
        <form asp-area="SlideMaker" asp-controller="AI" asp-action="QuickGenerate" method="post">
            @Html.AntiForgeryToken()
            <div class="input-group mb-2">
                <textarea class="form-control" id="quickAiText" name="RequirementText" placeholder="Describe what you want to create..." required></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary mic-btn" data-mic-for="quickAiText" title="Speak"><i class="bi bi-mic"></i> Voice</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-magic me-1"></i>Generate</button>
                <a class="btn btn-outline-secondary ms-auto" asp-area="SlideMaker" asp-controller="Template" asp-action="Index">Choose Template</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a class="text-decoration-none" asp-area="SlideMaker" asp-controller="Presentation" asp-action="Create" asp-route-mode="upload">
            <div class="card dashboard-card text-center p-3 h-100"><i class="bi bi-image fs-3 text-primary"></i><div class="mt-2">Upload Image</div></div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="text-decoration-none" asp-area="SlideMaker" asp-controller="Presentation" asp-action="Create" asp-route-mode="ai">
            <div class="card dashboard-card text-center p-3 h-100"><i class="bi bi-robot fs-3 text-primary"></i><div class="mt-2">AI Generate</div></div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="text-decoration-none" asp-area="SlideMaker" asp-controller="Presentation" asp-action="Create" asp-route-mode="bank">
            <div class="card dashboard-card text-center p-3 h-100"><i class="bi bi-collection fs-3 text-primary"></i><div class="mt-2">Question Bank <span class="badge bg-secondary">@Model.QuestionBankCount</span></div></div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="text-decoration-none" asp-area="SlideMaker" asp-controller="Template" asp-action="Index">
            <div class="card dashboard-card text-center p-3 h-100"><i class="bi bi-layout-text-window fs-3 text-primary"></i><div class="mt-2">Use Template</div></div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card dashboard-card">
            <div class="card-header bg-white fw-semibold">Recent Presentations</div>
            <div class="card-body p-0">
                @if (Model.RecentPresentations.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No presentations yet. Create your first one above.</div>
                }
                else
                {
                    <table class="table mb-0 align-middle">
                        <thead><tr><th>Name</th><th>Slides</th><th>Template</th><th>Created</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.RecentPresentations)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@p.SlideCount</td>
                                <td>@(p.TemplateName ?? "-")</td>
                                <td>@p.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@p.Status</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-area="SlideMaker" asp-controller="Presentation" asp-action="Preview" asp-route-id="@p.Id">Open</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card dashboard-card">
            <div class="card-header bg-white fw-semibold">My Templates</div>
            <div class="card-body">
                @if (Model.Templates.Count == 0)
                {
                    <div class="empty-state py-3"><i class="bi bi-layout-text-window fs-2 d-block mb-2"></i>No templates yet.</div>
                }
                else
                {
                    @foreach (var t in Model.Templates.Take(5))
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div>
                                <div class="fw-semibold">@t.Name @if (t.IsDefault) { <span class="badge bg-primary ms-1">Default</span> }</div>
                                <div class="text-muted small">@t.Description</div>
                            </div>
                        </div>
                    }
                }
                <a class="btn btn-sm btn-outline-primary mt-3 w-100" asp-area="SlideMaker" asp-controller="Template" asp-action="Index">Manage Templates</a>
            </div>
        </div>
    </div>
</div>
