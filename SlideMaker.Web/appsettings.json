{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Branding": {
    "AcademyName": "PS Academy"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AI": {
    "Provider": "Mock",
    "Ollama": {
      "Endpoint": "",
      "Model": ""
    },
    "OpenAICompatible": {
      "Endpoint": "",
      "ApiKey": "",
      "Model": ""
    }
  },
  "OCR": {
    "Provider": "Tesseract",
    "TessDataPath": "App_Data/tessdata",
    "Languages": "eng+hin"
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "MaxFileSizeMB": 50,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedDocumentExtensions": [ ".pdf", ".docx" ],
    "AllowedTemplateExtensions": [ ".pptx" ]
  }
}
